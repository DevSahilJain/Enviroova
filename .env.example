# Supabase configuration for ECOLOOP
# Copy this file to .env.local and fill in your project values.
# Public (client-safe) variables are prefixed with NEXT_PUBLIC_

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side (build-time) variables — required only for API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here