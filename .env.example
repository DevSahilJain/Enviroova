# ECOLOOP / Enviroova environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is gitignored.

# Server-side only. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
# Used by /api/energy/status and future live-provider integrations.
ENERGY_API_KEY=

# NVIDIA NIM API key for the AI Sustainability Analyst (server-only).
# Obtain from https://build.nvidia.com . Never expose to the browser.
NVIDIA_API_KEY=

# NVIDIA NIM chat model used by the AI Sustainability Analyst.
# Available chat models include:
#   nvidia/llama-3.1-nemotron-70b-instruct   (default)
#   nvidia/llama-3.1-nemotron-ultra-253b-v1
#   mistralai/mistral-large-2-instruct
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
